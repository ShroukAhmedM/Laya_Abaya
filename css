* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --black: #0b0b0b;
    --gold: #b68a45;
    --gold-light: #d4ad6b;
    --cream: #f8f5f0;
    --text: #222;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Cairo", sans-serif;
    color: var(--text);
    background: white;
}

button,
input {
    font-family: inherit;
}

button {
    cursor: pointer;
    border: none;
}

a {
    text-decoration: none;
    color: inherit;
}



/* TOP BAR */

.top-bar {
    height: 35px;
    background: #080808;
    color: var(--gold-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
}



/* HEADER */

.header {
    background: #0c0c0c;
    color: white;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.header-container {
    height: 100px;
    max-width: 1450px;
    margin: auto;
    padding: 0 40px;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.brand {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: var(--gold-light);
}

.brand-name {
    display: block;
    font-family: "Playfair Display", serif;
    font-size: 40px;
    letter-spacing: 5px;
}

.brand small {
    font-size: 9px;
    letter-spacing: 5px;
}

.desktop-menu {
    display: flex;
    gap: 35px;
}

.desktop-menu a {
    color: white;
    font-size: 14px;
    padding: 38px 0;
    position: relative;
}

.desktop-menu a:hover,
.desktop-menu a.active {
    color: var(--gold-light);
}

.desktop-menu a.active::after {
    content: "";

    position: absolute;

    bottom: 20px;
    right: 0;
    left: 0;

    height: 2px;

    background: var(--gold);
}

.header-icons {
    display: flex;
    gap: 18px;
}

.header-icons button {
    background: none;
    color: white;
    font-size: 22px;
}

.cart-button {
    position: relative;
}

.cart-button span {
    position: absolute;

    top: -8px;
    right: -8px;

    width: 17px;
    height: 17px;

    background: var(--gold);
    color: black;

    border-radius: 50%;

    display: grid;
    place-items: center;

    font-size: 10px;
}

.menu-button {
    display: none;
    background: none;
    color: white;
    font-size: 25px;
}



/* MOBILE MENU */

.mobile-menu {
    display: none;
    background: #0c0c0c;
    padding: 10px 20px 20px;
}

.mobile-menu.open {
    display: block;
}

.mobile-menu a {
    display: block;
    color: white;
    padding: 13px;
    border-bottom: 1px solid #252525;
}



/* HERO */

.hero {
    height: 500px;
    position: relative;
    overflow: hidden;
    background: #201b17;
    color: white;
}

.hero-image {
    position: absolute;
    inset: 0;

    background:
        linear-gradient(
            90deg,
            rgba(0,0,0,.05),
            rgba(0,0,0,.78)
        ),
        url("https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=1800&q=85");

    background-size: cover;
    background-position: center;
}

.hero-content {
    position: absolute;

    right: 10%;
    top: 50%;

    transform: translateY(-50%);

    text-align: center;

    min-width: 400px;
}

.hero-small {
    color: var(--gold-light);
    font-size: 11px;
    letter-spacing: 4px;
}

.hero h1 {
    font-size: 48px;
    margin: 15px 0;
}

.hero p {
    font-size: 18px;
    line-height: 2;
    margin-bottom: 25px;
}

.gold-button {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    padding: 13px 35px;

    color: white;

    background:
        linear-gradient(
            135deg,
            #c79d5d,
            #9e7338
        );

    transition: .3s;
}

.gold-button:hover {
    transform: translateY(-3px);
    filter: brightness(1.1);
}

.slider-dots {
    position: absolute;

    bottom: 25px;
    left: 50%;

    transform: translateX(-50%);

    display: flex;
    gap: 10px;
}

.dot {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: white;
    opacity: .6;
}

.dot.active {
    background: var(--gold-light);
    opacity: 1;
}



/* BENEFITS */

.benefits {
    background: #fbfaf8;

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 25px;

    padding: 22px 8%;
}

.benefit {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 15px;
}

.benefit > span {
    font-size: 30px;
    color: var(--gold);
}

.benefit strong {
    display: block;
    font-size: 14px;
}

.benefit small {
    color: #777;
    font-size: 10px;
}



/* PRODUCTS */

.products-section {
    padding: 55px 6%;
    text-align: center;
}

.section-title {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 20px;

    margin-bottom: 35px;
}

.section-title span {
    width: 60px;
    height: 1px;
    background: #c8aa7c;
}

.section-title h2 {
    font-size: 28px;
}

.products-grid {
    max-width: 1200px;
    margin: auto;

    display: grid;

    grid-template-columns:
        repeat(4, 1fr);

    gap: 22px;
}

.product-card {
    position: relative;

    border: 1px solid #e8e0d6;

    background: white;

    overflow: hidden;

    transition: .3s;
}

.product-card:hover {
    transform: translateY(-5px);

    box-shadow:
        0 15px 35px rgba(0,0,0,.1);
}

.product-image {
    height: 330px;

    background-size: cover;
    background-position: center;
}

.badge {
    position: absolute;

    top: 0;
    left: 0;

    background: var(--gold);

    color: white;

    padding: 5px 14px;

    font-size: 11px;
}

.wish {
    position: absolute;

    top: 10px;
    right: 10px;

    width: 30px;
    height: 30px;

    border-radius: 50%;

    background: rgba(255,255,255,.9);

    font-size: 20px;
}

.wish.active {
    color: #a33;
}

.product-info {
    padding: 13px;
}

.product-name {
    font-size: 13px;
    font-weight: 600;

    margin-bottom: 5px;
}

.price {
    font-weight: bold;
    font-size: 13px;
}

.swatches {
    display: flex;
    gap: 5px;
    margin-top: 8px;
}

.swatches i {
    width: 10px;
    height: 10px;

    border-radius: 50%;

    border: 1px solid #aaa;
}

.outline-button {
    margin-top: 30px;

    border: 1px solid #bda172;

    background: white;

    color: #76582f;

    padding: 11px 30px;
}

.outline-button:hover {
    background: #faf6ee;
}



/* CATEGORIES */

.categories {
    background: #f7f3ed;

    padding: 60px 6%;

    text-align: center;
}

.category-grid {
    max-width: 1100px;
    margin: auto;

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 25px;
}

.category-grid button {
    background: white;

    border: 1px solid #e5dccf;

    padding-bottom: 15px;

    transition: .3s;
}

.category-grid button:hover {
    transform: translateY(-5px);
}

.category-image {
    height: 280px;

    background-position: center;
    background-size: cover;
}

.category-one {
    background-image:
        url("https://images.unsplash.com/photo-1594633312681-425c7b97ccd1?auto=format&fit=crop&w=900&q=80");
}

.category-two {
    background-image:
        url("https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=900&q=80");
}

.category-three {
    background-image:
        url("https://images.unsplash.com/photo-1566206091558-7f218b696731?auto=format&fit=crop&w=900&q=80");
}

.category-grid strong {
    display: block;
    margin-top: 12px;
}



/* ABOUT */

.about {
    max-width: 1100px;
    margin: auto;

    padding: 80px 30px;

    display: grid;

    grid-template-columns:
        1fr 1fr;

    gap: 70px;

    align-items: center;
}

.about h2 {
    font-size: 35px;
    margin: 15px 0;
}

.about p {
    color: #666;
    line-height: 2;
    margin-bottom: 25px;
}

.about-card {
    height: 350px;

    background:
        linear-gradient(
            145deg,
            #171411,
            #4a3825
        );

    color: var(--gold-light);

    display: flex;

    flex-direction: column;

    align-items: center;

    justify-content: center;
}

.about-card span {
    font-family: "Playfair Display", serif;

    font-size: 65px;

    letter-spacing: 8px;
}

.about-card small {
    letter-spacing: 4px;
}



/* FOOTER */

footer {
    background: #0c0c0c;

    color: white;

    padding: 50px 7% 0;
}

.footer-grid {
    max-width: 1200px;
    margin: auto;

    display: grid;

    grid-template-columns:
        2fr 1fr 1fr 1fr;

    gap: 40px;

    padding-bottom: 35px;
}

.footer-grid h3,
.footer-grid h4 {
    color: var(--gold-light);
}

.footer-grid h3 {
    font-family: "Playfair Display", serif;

    letter-spacing: 4px;

    margin-bottom: 12px;
}

.footer-grid h4 {
    margin-bottom: 15px;
}

.footer-grid p,
.footer-grid a {
    color: #aaa;

    font-size: 12px;

    line-height: 2;
}

.footer-grid a {
    display: block;
}

.footer-grid a:hover {
    color: var(--gold-light);
}

.copyright {
    border-top: 1px solid #292929;

    text-align: center;

    padding: 18px;

    color: #777;

    font-size: 11px;
}



/* WHATSAPP */

.whatsapp {
    position: fixed;

    right: 22px;
    bottom: 20px;

    width: 55px;
    height: 55px;

    border-radius: 50%;

    background: #b58a4b;

    color: white;

    font-size: 22px;

    z-index: 900;

    box-shadow:
        0 8px 25px rgba(0,0,0,.25);
}



/* MODALS */

.modal {
    display: none;

    position: fixed;

    inset: 0;

    background: rgba(0,0,0,.7);

    z-index: 2000;

    align-items: center;
    justify-content: center;

    padding: 20px;
}

.modal.show {
    display: flex;
}

.modal-box {
    position: relative;

    background: white;

    width: min(600px,100%);

    max-height: 85vh;

    overflow-y: auto;

    padding: 35px;
}

.modal-box h3 {
    text-align: center;

    margin-bottom: 25px;

    font-size: 24px;
}

.close-button {
    position: absolute;

    top: 8px;
    left: 15px;

    font-size: 28px;

    background: none;

    color: #777;
}

.modal-box input {
    width: 100%;

    padding: 14px;

    border: 1px solid #ddd;

    outline: none;
}

.modal-box input:focus {
    border-color: var(--gold);
}

#searchResults {
    margin-top: 15px;
}

.search-result {
    padding: 12px;

    border-bottom: 1px solid #eee;

    cursor: pointer;
}

.search-result:hover {
    background: #faf7f1;
}

.cart-row {
    display: flex;

    justify-content: space-between;

    align-items: center;

    gap: 10px;

    padding: 14px 0;

    border-bottom: 1px solid #eee;
}

.cart-row button {
    color: #a33;
}

.cart-total {
    display: flex;

    justify-content: space-between;

    padding: 20px 0;

    font-size: 18px;
}

.full-button {
    width: 100%;
}



/* ================= MOBILE ================= */

@media(max-width:900px) {

    .header-container {
        height: 75px;
        padding: 0 18px;
    }

    .desktop-menu {
        display: none;
    }

    .menu-button {
        display: block;
    }

    .brand {
        position: static;
        transform: none;
    }

    .brand-name {
        font-size: 30px;
    }

    .brand small {
        font-size: 7px;
    }

    .hero {
        height: 550px;
    }

    .hero-content {
        right: 5%;
        left: 5%;
        min-width: 0;
    }

    .hero h1 {
        font-size: 38px;
    }

    .hero p {
        font-size: 15px;
    }

    .benefits {
        grid-template-columns: repeat(2,1fr);
    }

    .products-grid {
        grid-template-columns: repeat(2,1fr);
    }

    .product-image {
        height: 280px;
    }

    .category-grid {
        grid-template-columns: repeat(2,1fr);
    }

    .about {
        grid-template-columns: 1fr;
    }

    .footer-grid {
        grid-template-columns: repeat(2,1fr);
    }
}



@media(max-width:560px) {

    .top-bar {
        font-size: 10px;
    }

    .header-icons {
        gap: 8px;
    }

    .header-icons button {
        font-size: 18px;
    }

    .hero {
        height: 520px;
    }

    .hero-content {
        top: 55%;
    }

    .hero h1 {
        font-size: 32px;
    }

    .hero p {
        font-size: 14px;
    }

    .benefits {
        gap: 10px;
        padding: 20px 4%;
    }

    .benefit {
        justify-content: flex-start;
    }

    .benefit > span {
        font-size: 22px;
    }

    .benefit strong {
        font-size: 11px;
    }

    .benefit small {
        font-size: 8px;
    }

    .products-section {
        padding: 40px 10px;
    }

    .products-grid {
        gap: 10px;
    }

    .product-image {
        height: 220px;
    }

    .product-name {
        font-size: 11px;
    }

    .price {
        font-size: 11px;
    }

    .category-grid {
        grid-template-columns: 1fr;
    }

    .category-image {
        height: 330px;
    }

    .about {
        padding: 55px 20px;
    }

    .about-card {
        height: 280px;
    }

    .about-card span {
        font-size: 48px;
    }

    .footer-grid {
        grid-template-columns: 1fr;
    }

    .section-title h2 {
        font-size: 22px;
    }

    .section-title span {
        width: 35px;
    }
}